@techreport{cockriel2025aggregate,
  title = {Aggregate Economic Gains from Road Improvements in Eastern Europe and Central Asia},
  author = {William Cockriel and Richard Hornbeck and Martin Rotemberg},
  institution = {Florida State University, University of Chicago, NYU},
  year = {2025},
  month = {August},
  abstract = {We examine aggregate economic gains in Eastern Europe and Central Asia from potential improvements to the road network. We focus on the effects from reallocating economic activity within a country, given spatial dispersion in the marginal productivity of inputs from economic frictions and resulting misallocation. Aggregate productivity increases when road improvements reallocate activity to places with relatively higher marginal products, and could in principle decrease if activity shifts to places with relatively lower marginal products. We develop a toolkit to calculate aggregate effects by country, which depend on the spatial dispersion in marginal products and which places gain market access from road improvements. We calculate that each country experiences aggregate productivity growth from these road improvements, ranging between 0.1\% and 4.6\%, which are worth in total between \$3.6 and \$18.1 billion annually across three proposed policy scenarios. Real wages also increase in each country, reflecting additional payments to labor in addition to aggregate productivity growth, worth in total between \$6.2 and \$29 billion annually across three policy scenarios.},
  note = {Working Paper}
}

